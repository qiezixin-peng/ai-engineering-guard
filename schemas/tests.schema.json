{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-engineering-guard.dev/schemas/tests.v1.schema.json",
  "title": "AEG Project Test Suites and Regressions",
  "type": "object",
  "required": ["suites"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "suites": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["framework", "command", "covers", "level"],
        "additionalProperties": false,
        "properties": {
          "framework": {
            "type": "string",
            "enum": ["vitest", "jest", "pytest", "playwright", "node-test", "go-test", "cargo-test", "command"]
          },
          "command": {
            "type": "object",
            "required": ["executable"],
            "additionalProperties": false,
            "properties": {
              "executable": { "type": "string", "minLength": 1 },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              },
              "cwd": { "type": "string", "default": "." },
              "timeout": { "type": "string", "default": "10m" },
              "shell": { "type": "boolean", "default": false },
              "environment_allowlist": {
                "type": "array",
                "items": { "type": "string" },
                "default": []
              }
            }
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "level": {
            "type": "string",
            "enum": ["static", "unit", "integration", "e2e", "security", "full"]
          },
          "critical": { "type": "boolean", "default": false },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "execution_variant": { "type": "string" },
          "estimated_duration": { "type": "string" },
          "cache": {
            "oneOf": [
              { "type": "boolean" },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean", "default": true },
                  "cross_commit": {
                    "type": "string",
                    "enum": ["disabled", "shadow", "enabled"],
                    "default": "disabled"
                  },
                  "hermetic": { "type": "boolean", "default": false },
                  "inputs": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": []
                  }
                }
              }
            ]
          },
          "platforms": {
            "type": "array",
            "items": { "type": "string", "enum": ["windows", "linux", "macos"] },
            "default": ["windows", "linux", "macos"]
          },
          "execution": {
            "type": "string",
            "enum": ["once_per_change", "each_platform"],
            "default": "each_platform"
          },
          "portable": { "type": "boolean", "default": false },
          "canonical_platform": {
            "type": "string",
            "enum": ["windows", "linux", "macos"]
          },
          "capabilities": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      }
    },
    "regressions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["id", "suite", "trigger_paths"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "suite": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "trigger_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
