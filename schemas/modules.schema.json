{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-engineering-guard.dev/schemas/modules.v1.schema.json",
  "title": "AEG Project Module Graph",
  "type": "object",
  "required": ["modules"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["paths"],
        "additionalProperties": false,
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "criticality": {
            "type": "string",
            "enum": ["low", "normal", "high", "critical"],
            "default": "normal"
          },
          "public_api_paths": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "contracts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "data_models": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "default": []
          },
          "owner": {
            "type": "string"
          }
        }
      }
    }
  }
}
